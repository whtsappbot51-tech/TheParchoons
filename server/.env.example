# Server
PORT=3000
NODE_ENV=development
SERVER_URL=http://localhost:3000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/theparchoons

# Auth
JWT_SECRET=your_jwt_secret_change_this_in_production
ADMIN_DEFAULT_EMAIL=admin@theparchoons.com
ADMIN_DEFAULT_PASSWORD=admin123

# WhatsApp Cloud API
WHATSAPP_TOKEN=your_whatsapp_access_token
PHONE_NUMBER_ID=your_phone_number_id
VERIFY_TOKEN=theparchoons_verify_token_123
OWNER_PHONE=91XXXXXXXXXX
BOT_PHONE=91XXXXXXXXXX

# Store Location & Delivery
STORE_LATITUDE=0.0
STORE_LONGITUDE=0.0
DELIVERY_RADIUS_METERS=500
DELIVERY_FEE=0
FREE_DELIVERY_ABOVE=0
MIN_ORDER_AMOUNT=0

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (future)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
